{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build --workspace frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 30
    },
    "api/gateway.ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(?!gateway(?:/|$))(.*)",
      "dest": "/api/gateway?path=/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}

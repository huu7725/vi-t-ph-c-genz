{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "viet-phuc-remix-api": {
      "root": "backend",
      "framework": "express",
      "installCommand": "npm install --include=dev",
      "buildCommand": "npm run build -w backend"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm install --include=dev",
      "buildCommand": "npm run build -w frontend"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "viet-phuc-remix-api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
